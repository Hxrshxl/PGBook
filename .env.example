# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/pgbook

# Secret used to sign login sessions. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Optional: separate key for encrypting secrets at rest (admin 2FA seeds).
# Defaults to a key derived from JWT_SECRET. Changing it means admins re-enrol 2FA.
# DATA_ENCRYPTION_KEY=another-long-random-string-of-at-least-32-chars
