# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/pgbook

# Secret used to sign login sessions. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Optional: separate key for encrypting secrets at rest (admin 2FA seeds).
# Defaults to a key derived from JWT_SECRET. Changing it means admins re-enrol 2FA.
# DATA_ENCRYPTION_KEY=another-long-random-string-of-at-least-32-chars

# ── Subscriptions (Razorpay) ─────────────────────────────────
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx            # webhook URL: https://<domain>/api/billing/webhook
# RAZORPAY_PLAN_STARTER_MONTHLY=plan_xxx # one plan id per plan and interval (STARTER|PRO|MULTI × MONTHLY|YEARLY)
# GST invoices (leave BILLING_GSTIN empty if not GST-registered)
# BILLING_LEGAL_NAME=PGBook Technologies
# BILLING_ADDRESS=...
# BILLING_GSTIN=29ABCDE1234F1Z5
# BILLING_STATE_CODE=29
# Daily reminders: Vercel Cron (vercel.json) sends "Authorization: Bearer $CRON_SECRET"
# CRON_SECRET=a-long-random-string

# ── Tenant app login codes (SMS) ──────────────────────────────
# SMS_PROVIDER=msg91   with MSG91_AUTH_KEY, MSG91_OTP_TEMPLATE_ID
# SMS_PROVIDER=twilio  with TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
# ── Email (billing notices) ───────────────────────────────────
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=PGBook <billing@yourdomain.in>

# Local development only: test-mode billing and on-screen login codes, on localhost only.
# PGBOOK_DEV_FALLBACKS=true
